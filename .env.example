# Canonical site URL for Open Graph, sitemap, and metadata (no trailing slash).
# REQUIRED on Vercel — set in Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL="https://ratul-saha-roy.pro.bd"
NEXT_PUBLIC_APP_URL="https://ratul-saha-roy.pro.bd"

